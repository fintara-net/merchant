# Base path of the backend API (no trailing slash).
# In development Vite forwards /api to the backend (see API_PROXY_TARGET).
VITE_API_BASE_URL=/api/v1
# Where the dev server forwards /api requests (development only)
API_PROXY_TARGET=http://localhost:5076
# Where the built app is served (build only). Default "/". Under a path, e.g.
#   BASE_PATH=/merchant/  together with  VITE_API_BASE_URL=/merchant/api/v1
BASE_PATH=/
