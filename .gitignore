# Everything this app needs ignored, so it works on its own as well as inside the
# larger repo.

# ── Dependencies ──────────────────────────────
node_modules/
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/releases
.pnp.*

# ── Build output ──────────────────────────────
dist/
dist-ssr/
build/
*.tsbuildinfo

# ── Tool caches ───────────────────────────────
.vite/
.tanstack/
.eslintcache
.prettiercache
.stylelintcache
.cache/
.temp/
.tmp/

# ── Tests & coverage ──────────────────────────
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# ── Environment ───────────────────────────────
# Only .env.example (no real values) is committed
.env
.env.*
!.env.example
*.local

# ── Package manager logs ──────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Secrets & keys ────────────────────────────
*.pem
*.key
*.crt
*.p12
*.pfx

# ── Logs ──────────────────────────────────────
logs/
*.log

# ── Editors ───────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
*.sublime-workspace

# ── OS files ──────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
