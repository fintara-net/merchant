# Frontend-specific ignores. Repo-wide rules (secrets, logs, editors, OS files)
# live in the root .gitignore.

# ── Dependencies ──────────────────────────────
node_modules/
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/releases
.pnp.*

# ── Build output ──────────────────────────────
dist/
dist-ssr/
build/
*.tsbuildinfo

# ── Tool caches ───────────────────────────────
.vite/
.tanstack/
.eslintcache
.prettiercache
.stylelintcache
.cache/
.temp/
.tmp/

# ── Tests & coverage ──────────────────────────
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# ── Environment ───────────────────────────────
# Only .env.example (no real values) is committed
.env
.env.*
!.env.example
*.local

# ── Package manager logs ──────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
